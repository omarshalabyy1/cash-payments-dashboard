{
  "name": "Cash dashboard",
  "dataColors": ["#2563EB", "#0E1630", "#1D4FD7", "#4A5675", "#8DB0FF", "#16203F", "#AEB8D3", "#E8EFFF"],
  "background": "#FFFFFF",
  "foreground": "#0E1630",
  "tableAccent": "#2563EB",
  "good": "#2563EB",
  "neutral": "#AEB8D3",
  "bad": "#C2410C",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#0E1630" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0E1630" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0E1630" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#4A5675" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6FB" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E2E7F1" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#0E1630" } } }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#4A5675" } } }]
      }
    }
  }
}
